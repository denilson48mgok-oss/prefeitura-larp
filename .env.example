# Variáveis de ambiente — Prefeitura LARP
# Copie este arquivo para .env e preencha os valores reais.
# NUNCA faça commit do arquivo .env com valores reais.

# ──────────────────────────────────────────
# Keystatic CMS — Modo de operação
# ──────────────────────────────────────────

# "local"  → Usa o sistema de arquivos local (desenvolvimento)
# "github" → Usa o repositório GitHub como backend (produção)
PUBLIC_KEYSTATIC_MODE=local

# ──────────────────────────────────────────
# Keystatic — Configuração GitHub (apenas modo "github")
# Necessário somente em produção. Será configurado no Passo 7.
# ──────────────────────────────────────────

# ID do OAuth App criado no GitHub
# KEYSTATIC_GITHUB_CLIENT_ID=

# Secret do OAuth App criado no GitHub
# KEYSTATIC_GITHUB_CLIENT_SECRET=

# Token secreto para assinar as sessões (string aleatória longa)
# KEYSTATIC_SECRET=

# ──────────────────────────────────────────
# Informações do repositório GitHub
# ──────────────────────────────────────────

# Usuário/organização dona do repositório
# PUBLIC_GITHUB_REPO_OWNER=seu-usuario

# Nome do repositório
# PUBLIC_GITHUB_REPO_NAME=prefeitura-larp
